; WorldRPGs — prototipo da fatia 1
; Engine: Godot 4.7.1-stable
; Alvo: 1920x1080 @ 60 fps estaveis, Intel Iris Xe integrados, 8 GB RAM (Lei 4)

config_version=5

[application]

config/name="WorldRPGs - Prototipo"
config/description="Prototipo da fatia 1. Combate do WP1 fiel a spec/01-combate.md."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameData="*res://src/autoload/game_data.gd"
Bench="*res://src/autoload/bench.gd"
Sfx="*res://src/autoload/sfx.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
3d/default_gravity=20.0

[rendering]

; Renderer escolhido por MEDICAO, nao por gosto — ver PERF.md.
; "mobile" ganhou: melhor 1% low (250,9 vs 171,7) e -33% de VRAM que o Forward+,
; o que numa maquina de 8 GB com graficos a partilhar a RAM conta a dobrar.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/ssao/quality=0
environment/ssil/quality=0
environment/glow/upscale_mode=0
environment/screen_space_reflection/roughness_quality=0
environment/subsurface_scattering/subsurface_scattering_quality=0
driver/depth_prepass/enable=true
