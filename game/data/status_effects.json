  "_design_decision": {
    "tag": "[CODEX]",
    "choice": "Implementar veneno, sangramento e queimadura como estados de barra.",
    "reason": "São os três estados já fechados no spec/68, têm origem em biomas de Brumal e saídas existentes no catálogo; cada um faz uma pergunta diferente ao jogador.",
    "discarded_alternative": "Adicionar gelo e maldição. Gelo já é elemento e perigo de exposição; maldição não tem saída, cura nem contrato aprovado e criaria punição sem aviso recuperável.",
    "active_rebuild_policy": {
      "tag": "[CODEX]",
      "choice": "Uma barra não volta a acumular enquanto o seu estado de duração está ativo.",
      "reason": "Evita preparar às escondidas um segundo disparo enquanto a barra está vazia e o jogador gere a saída atual.",
      "discarded_alternative": "Deixar acumular durante o efeito; permitiria encadear veneno ou queimadura sem um novo ciclo visível de reação."
    }
  },
